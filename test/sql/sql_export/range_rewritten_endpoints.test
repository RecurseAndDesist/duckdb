9	9

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN coalesce(x, 1) PRECEDING AND CASE WHEN true THEN x ELSE 1 END FOLLOWING) FROM range_rewrites ORDER BY id
