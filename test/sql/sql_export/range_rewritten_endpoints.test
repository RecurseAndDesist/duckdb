2	6
3	28
4	15
5	18
6	27
7	22
8	15
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN (SELECT 1) PRECEDING AND (SELECT max(x) FROM range_rewrites) FOLLOWING) FROM range_rewrites ORDER BY id
----
