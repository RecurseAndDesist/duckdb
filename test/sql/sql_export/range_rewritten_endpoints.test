# a filter that leaves one value for the offset or for the key

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN x PRECEDING AND CURRENT ROW) FROM range_rewrites WHERE x = 1 ORDER BY id
----
2	2
7	7
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN x PRECEDING AND 1 FOLLOWING) FROM range_rewrites WHERE a = 3 ORDER BY id
----
4	15
5	15
6	15

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM range_rewrites WHERE a = 3 ORDER BY id
----
4	15
5	15
6	15

# an offset parameter

statement ok
PREPARE range_parameters AS SELECT id, sum(id) OVER (ORDER BY a + 1 RANGE BETWEEN ? PRECEDING AND ? FOLLOWING) FROM range_rewrites ORDER BY id;

query II
EXECUTE range_parameters(1, 2)
----
1	6
2	21
3	27
4	25
5	25
6	25
7	30
8	8
9	9

query II
EXECUTE range_parameters(0, 0)
----
1	1
2	2
3	3
4	15
5	15
6	15
7	7
8	8
9	9

# frames next to each other, with partitions and exclusion

query IIII
SELECT id, sum(id) OVER (PARTITION BY b ORDER BY a + 1 RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING), count(*) OVER (ORDER BY a RANGE BETWEEN 1 - 1 PRECEDING AND x FOLLOWING EXCLUDE CURRENT ROW), first_value(id) OVER (ORDER BY 7 RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING EXCLUDE TIES) FROM range_rewrites ORDER BY id
----
1	4	0	1
2	6	1	2
3	15	4	3
4	4	2	4
5	15	2	5
6	6	3	6
7	12	0	7
8	8	0	8
9	9	0	9

# ROWS and GROUPS frames, and RANGE frames without an offset

query IIIII
SELECT id, sum(id) OVER (ORDER BY a + 1 ROWS BETWEEN 1 PRECEDING AND 2 - 1 FOLLOWING), sum(id) OVER (ORDER BY a + 1 GROUPS BETWEEN 1 - 1 PRECEDING AND coalesce(x, 0) FOLLOWING), sum(id) OVER (ORDER BY a + 1 RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), sum(id) OVER (ORDER BY 7 ROWS BETWEEN coalesce(x, 0) PRECEDING AND CURRENT ROW) FROM range_rewrites ORDER BY id
----
1	3	1	1	1
2	6	5	3	3
3	9	25	6	6
4	12	15	21	4
5	15	15	21	5
6	18	30	21	15
7	21	15	28	13
8	24	17	36	21
9	17	9	45	17

endloop

endloop

statement ok
SET debug_verify_statement='none';

statement ok
SET debug_verify_serializer=false;

# the exported frame is the SQL frame: the ordering operand and the offsets in the type of the arithmetic
query TT
EXPLAIN (SQL) SELECT sum(id) OVER (ORDER BY a + 1 RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM range_rewrites
----
sql	<REGEX>:.*CAST\(1 AS INTEGER\)\) ASC NULLS LAST RANGE BETWEEN CAST\(1 AS INTEGER\) PRECEDING AND CAST\(2 AS INTEGER\) FOLLOWING.*

query TT
EXPLAIN (SQL) SELECT sum(id) OVER (ORDER BY a RANGE BETWEEN 2 - 1 PRECEDING AND 1 - 1 FOLLOWING) FROM range_rewrites
----
sql	<REGEX>:.*RANGE BETWEEN CAST\(1 AS INTEGER\) PRECEDING AND CAST\(0 AS INTEGER\) FOLLOWING.*

query TT
EXPLAIN (SQL) SELECT count(*) OVER (ORDER BY 7543 RANGE BETWEEN x PRECEDING AND CURRENT ROW) FROM range_rewrites
----
sql	<REGEX>:.*ORDER BY CAST\(7543 AS INTEGER\) ASC NULLS LAST RANGE BETWEEN [a-z0-9]+\.[a-z0-9]+ PRECEDING AND CURRENT ROW.*

# a RANGE frame over column offsets, and ROWS and GROUPS frames, read the live endpoints
query TT
EXPLAIN (SQL) SELECT sum(id) OVER (ORDER BY a RANGE BETWEEN x PRECEDING AND b FOLLOWING) FROM range_rewrites
----
sql	<REGEX>:.*RANGE BETWEEN [a-z0-9]+\.[a-z0-9]+ PRECEDING AND [a-z0-9]+\.[a-z0-9]+ FOLLOWING.*

query TT
EXPLAIN (SQL) SELECT sum(id) OVER (ORDER BY a + 1 ROWS BETWEEN 1 PRECEDING AND 2 - 1 FOLLOWING) FROM range_rewrites
----
sql	<REGEX>:.*ROWS BETWEEN CAST\(1 AS BIGINT\) PRECEDING AND CAST\(1 AS BIGINT\) FOLLOWING.*

query TT
EXPLAIN (SQL) SELECT sum(id) OVER (ORDER BY a + 1 GROUPS BETWEEN 1 - 1 PRECEDING AND 2 FOLLOWING) FROM range_rewrites
----
sql	<REGEX>:.*GROUPS BETWEEN CAST\(0 AS BIGINT\) PRECEDING AND CAST\(2 AS BIGINT\) FOLLOWING.*
