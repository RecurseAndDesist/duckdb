# name: test/sql/sql_export/range_rewritten_endpoints.test
# description: RANGE frames whose endpoint arithmetic or ordering key the optimizer rewrote are exported
# group: [sql_export]

require skip_reload

statement ok
CREATE TABLE range_rewrites AS SELECT id, a::INTEGER AS a, x::INTEGER AS x, b::BIGINT AS b, DATE '2024-02-27' + a::INTEGER AS d FROM (VALUES (1, 0, 0, 1), (2, 1, 1, 2), (3, 2, 2, 1), (4, 3, 0, 2), (5, 3, NULL, 1), (6, 3, 2, NULL), (7, 4, 1, 1), (8, 6, 2, 2), (9, NULL, 1, 1)) t(id, a, x, b);

statement ok
SET VARIABLE range_one = 1;

foreach serializer false true

statement ok
SET debug_verify_serializer={serializer};

foreach mode none explain_sql_strict

statement ok
SET debug_verify_statement='{mode}';

# constants of the ordering key and of the offset are merged: (a + 1) + 2 is computed as a + 3

query II
SELECT id, sum(id) OVER (ORDER BY a + 1 RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	6
2	21
3	27
4	25
5	25
6	25
7	30
8	8
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a + 1 RANGE BETWEEN CURRENT ROW AND 2 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	6
2	20
3	25
4	22
5	22
6	22
7	15
8	8
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a + 1 DESC RANGE BETWEEN 2 PRECEDING AND 1 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	6
2	21
3	27
4	25
5	25
6	25
7	30
8	8
9	9

query II
SELECT id, sum(id) OVER (ORDER BY 1 + a DESC NULLS LAST RANGE BETWEEN 2 PRECEDING AND UNBOUNDED FOLLOWING) FROM range_rewrites ORDER BY id
----
1	15
2	30
3	37
4	37
5	37
6	37
7	45
8	45
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a - 1 ASC NULLS FIRST RANGE BETWEEN 2 PRECEDING AND 1 PRECEDING) FROM range_rewrites ORDER BY id
----
1	NULL
2	1
3	3
4	5
5	5
6	5
7	18
8	7
9	9

query II
SELECT id, sum(id) OVER (ORDER BY (a + 1) + 2 RANGE BETWEEN 1 FOLLOWING AND 3 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	20
2	25
3	22
4	15
5	15
6	15
7	8
8	NULL
9	9

query II
SELECT id, sum(id) OVER (ORDER BY b + 1 RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	39
2	39
3	39
4	39
5	39
6	6
7	39
8	39
9	39

query II
SELECT id, count(*) OVER (ORDER BY d + 1 RANGE BETWEEN INTERVAL 1 DAY PRECEDING AND INTERVAL 2 DAY FOLLOWING) FROM range_rewrites ORDER BY id
----
1	3
2	6
3	6
4	5
5	5
6	5
7	5
8	1
9	1

# the same key computed below the window

query II
SELECT id, sum(id) OVER (ORDER BY k RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING) FROM (SELECT id, a + 1 AS k FROM range_rewrites) ORDER BY id
----
1	6
2	21
3	27
4	25
5	25
6	25
7	30
8	8
9	9

query II
SELECT id, sum(id) OVER (ORDER BY k DESC RANGE BETWEEN o PRECEDING AND 2 FOLLOWING) FROM (SELECT id, a + 1 AS k, x AS o FROM range_rewrites) ORDER BY id
----
1	1
2	6
3	28
4	20
5	20
6	27
7	25
8	15
9	9

# a constant expression offset, folded while the frame is bound, and its zero, whose arithmetic is removed

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN 2 - 1 PRECEDING AND 1 - 1 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	1
2	3
3	5
4	18
5	18
6	18
7	22
8	8
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a DESC RANGE BETWEEN 1 - 1 PRECEDING AND 2 - 1 FOLLOWING) FROM range_rewrites ORDER BY id
