3	33
4	30
5	15
6	30
7	15
8	8
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN abs(x) PRECEDING AND CASE WHEN x > 1 THEN 1 ELSE 2 END FOLLOWING) FROM range_rewrites ORDER BY id
