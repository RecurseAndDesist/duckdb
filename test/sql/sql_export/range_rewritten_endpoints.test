2	6
3	28
4	15
5	15
6	27
7	22
8	15
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN x - x PRECEDING AND (x + 1) + 2 FOLLOWING) FROM range_rewrites ORDER BY id
