2	9
3	9
4	9
5	9
6	9
7	9
8	9
9	9

query II
SELECT id, count(*) OVER (ORDER BY 7 RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM range_rewrites ORDER BY id
