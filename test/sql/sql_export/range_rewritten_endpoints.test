9	9

# non-constant offsets: a column, expressions the optimizer simplifies, a subquery, another type

query II
SELECT id, sum(id) OVER (ORDER BY a RANGE BETWEEN x PRECEDING AND x % 2 FOLLOWING) FROM range_rewrites ORDER BY id
----
1	1
2	6
3	6
4	15
5	15
6	20
7	22
8	15
9	9

query II
SELECT id, sum(id) OVER (ORDER BY a DESC RANGE BETWEEN x + 0 PRECEDING AND x * 1 FOLLOWING) FROM range_rewrites ORDER BY id
----
